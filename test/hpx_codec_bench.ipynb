    "codec={}\n",
    "for k in rd_df.codec:\n",
    "    codec[k]=1\n",
    "scene={}\n",
    "for k in rd_df.scene:\n",
    "    scene[k]=1\n",
    "scene=[k for k in scene]\n",
    "codec=[k for k in codec]\n",
    "\n",
    "color=['black','grey','b','r','orange','pink','darkblue','yellow']\n",
    "target_rmse=np.array([1E-5,1E-4,1E-3])\n",
    "plt.figure(figsize=(16,16))\n",
    "for k in range(len(codec)):\n",
    "    for l in range(len(scene)):\n",
    "        \n",
    "        if codec[k]!='uncompressed' and codec[k]!='jpeg2000_lossless' and codec[k]!='jpegxl_lossless':\n",
    "            norme=float(np.array(rd_df[(rd_df.codec=='uncompressed')].total_bytes)[0])\n",
    "            plt.subplot(3,3,1+l)\n",
    "            # np.interp exige un axe x croissant\n",
    "            rmse=np.array(rd_df[(rd_df.codec==codec[k])&(rd_df.scene==scene[l])].rmse)\n",
    "            if rmse.min()>target_rmse.min() or rmse.max()target_rmse.max():\n",
    "                \n",
    "            size=np.array(rd_df[(rd_df.codec==codec[k])&(rd_df.scene==scene[l])].total_bytes)/norme\n",
    "            idx = np.argsort(rmse)\n",
    "    \n",
    "            estimated_log_size = np.interp(\n",
    "                np.log(target_rmse),\n",
    "                np.log(rmse[idx]),\n",
    "                np.log(size[idx])\n",
    "            )\n",
    "    \n",
    "            estimated_size = np.exp(estimated_log_size)\n",
    "    \n",
    "            plt.loglog(target_rmse,estimated_size,label=codec[k],color=color[k])\n",
    "\n",
    "for l in range(len(scene)):\n",
    "    plt.subplot(3,3,1+l)\n",
    "    if l==0:\n",
    "        plt.legend()\n",
    "    plt.xlabel('RMSE')\n",
    "    plt.ylabel('Size vs original size')\n",
    "    plt.title(scene[l])"
   ]
  },
