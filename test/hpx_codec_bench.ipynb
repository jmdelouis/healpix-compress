    "# --- Diagnostic: per-scene RD curves (size vs RMSE), one panel per scene --\n",
    "# Lets you read off, for any target RMSE, roughly what size each codec needs\n",
    "# on a given scene -- useful for sanity-checking sweep coverage (a codec\n",
    "# whose curve is short/flat and stuck at high RMSE needs a wider sweep, see\n",
    "# the widened JPEG2000/JPEG XL ranges above) before trusting the aggregate\n",
    "# fig_error_at_constant_size / fig_storage_at_constant_rmse figures.\n",
    "codec = {}\n",
    "for k in rd_df.codec:\n",
    "    codec[k] = 1\n",
    "scene = {}\n",
    "for k in rd_df.scene:\n",
    "    scene[k] = 1\n",
    "scene = [k for k in scene]\n",
    "codec = [k for k in codec]\n",
    "\n",
    "# Codecs with a single fixed configuration (no sweep) have exactly one\n",
    "# (rmse, bytes) point per scene -- there is nothing to interpolate a curve\n",
    "# through, so they are drawn as a single marker instead of a line.\n",
    "LOSSLESS_CODECS = {\"jpeg2000_lossless\", \"jpegxl_lossless\"}\n",
    "\n",
    "n_cols = 3\n",
    "n_rows = int(np.ceil(len(scene) / n_cols))\n",
    "fig, axes = plt.subplots(n_rows, n_cols, figsize=(4.3 * n_cols, 3.4 * n_rows))\n",
    "axes = np.atleast_1d(axes).ravel()\n",
    "\n",
    "for ax, sc in zip(axes, scene):\n",
    "    for cd in codec:\n",
    "        if cd == \"uncompressed\":\n",
    "            continue\n",
    "        g = rd_df[(rd_df.scene == sc) & (rd_df.codec == cd)]\n",
    "        g = g.replace([np.inf, -np.inf], np.nan).dropna(subset=[\"rmse\", \"total_bytes\"])\n",
    "        g = g[g[\"rmse\"] > 0]\n",
    "        if g.empty:\n",
    "            continue\n",
    "        style = CODEC_STYLE.get(cd, dict(color=\"grey\", marker=\"x\"))\n",
    "        if cd in LOSSLESS_CODECS or len(g) < 2:\n",
    "            ax.scatter(g[\"rmse\"], g[\"total_bytes\"], color=style[\"color\"],\n",
    "                       marker=style[\"marker\"], s=80, edgecolor=\"white\",\n",
    "                       linewidth=0.7, zorder=5, label=cd)\n",
    "        else:\n",
    "            g = g.sort_values(\"rmse\")\n",
    "            ax.plot(g[\"rmse\"], g[\"total_bytes\"], color=style[\"color\"],\n",
    "                    marker=style[\"marker\"], markersize=5, linewidth=1.4, label=cd)\n",
    "    ax.set_xscale(\"log\")\n",
    "    ax.set_yscale(\"log\")\n",
    "    ax.set_title(sc, fontsize=10)\n",
    "    ax.grid(True, which=\"both\", linewidth=0.3, alpha=0.4)\n",
    "\n",
    "for ax in axes[len(scene):]:\n",
    "    ax.axis(\"off\")\n",
    "\n",
    "fig.supxlabel(\"RMSE (HEALPix tile grid, log scale)\")\n",
    "fig.supylabel(\"Compressed size [bytes] (log scale)\")\n",
    "handles, labels = [], []\n",
    "for ax in axes[:len(scene)]:\n",
    "    h, l = ax.get_legend_handles_labels()\n",
    "    for hi, li in zip(h, l):\n",
    "        if li not in labels:\n",
    "            handles.append(hi)\n",
    "            labels.append(li)\n",
    "fig.legend(handles, labels, loc=\"lower center\", ncol=min(len(labels), 4),\n",
    "           bbox_to_anchor=(0.5, -0.04), fontsize=9, frameon=False)\n",
    "fig.suptitle(\"Rate-distortion curves per scene\", y=1.02)\n",
    "fig.tight_layout(rect=[0, 0.06, 1, 1])\n",
    "fig.savefig(FIGURES_DIR / \"fig_rd_curves_per_scene.pdf\", bbox_inches=\"tight\")\n",
    "fig.savefig(FIGURES_DIR / \"fig_rd_curves_per_scene.png\", dpi=150, bbox_inches=\"tight\")\n",
    "plt.show()\n"
   ]
